<UserControl x:Class="VsAgentic.VSExtension.ToolWindows.Banners.ConflictBannerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VsAgentic.VSExtension;component/ToolWindows/Banners/BannerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Not a prompt: the chat goes on while it is shown. -->
    <Border Style="{StaticResource BannerCardBorderStyle}">
        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                       Margin="12,10,12,4"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding DetailMessage}"
                       FontSize="12"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"
                       Margin="12,0,12,4"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding SubText}"
                       FontSize="11"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"
                       Margin="12,0,12,8"
                       TextWrapping="Wrap"/>

            <TextBlock Text="{Binding Warning}"
                       FontSize="11"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                       Margin="12,0,12,8"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasWarning}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- One row per file one side deleted: Visual Studio 18.11 offers no side to pick for it. -->
            <ItemsControl ItemsSource="{Binding DeleteConflicts}"
                          Focusable="False"
                          Margin="12,0,12,8"
                          Visibility="{Binding HasDeleteConflicts, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2,0,2" LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Keep"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding KeepCommand}"
                                        Visibility="{Binding CanKeep, Converter={StaticResource BoolToVis}}"
                                        ToolTip="Keep the file as it is in the working folder (git add)"/>
                                <Button Content="Delete"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DeleteCommand}"
                                        ToolTip="Delete the file (git rm)"/>
                            </StackPanel>
                            <TextBlock FontSize="12"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}">
                                <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold"/>
                                <Run Text="—"/>
                                <Run Text="{Binding Description, Mode=OneWay}"/>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Wraps in a narrow chat window instead of cutting off a button. -->
            <WrapPanel HorizontalAlignment="Right"
                       Margin="6,0,12,10">
                <Button Content="{Binding ResolveLabel}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding ResolveCommand}"
                        Visibility="{Binding ShowResolve, Converter={StaticResource BoolToVis}}"
                        ToolTip="Send a request to resolve these files. Text in the message box goes with it."/>
                <!-- The main action once no file holds conflict blocks; a second one before. -->
                <Button Content="{Binding MarkResolvedLabel}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding MarkResolvedCommand}"
                        Visibility="{Binding MarkResolvedIsMain, Converter={StaticResource BoolToVis}}"
                        ToolTip="Stage the edited files (git add), as accepting the merge would. Files that still hold conflict markers are left out."/>
                <Button Content="{Binding MarkResolvedLabel}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding MarkResolvedCommand}"
                        Visibility="{Binding MarkResolvedIsSecond, Converter={StaticResource BoolToVis}}"
                        ToolTip="Stage the edited files (git add), as accepting the merge would. Files that still hold conflict markers are left out."/>
                <Button Content="Dismiss"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding DismissCommand}"
                        ToolTip="Hide this notice until the conflicts change"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
