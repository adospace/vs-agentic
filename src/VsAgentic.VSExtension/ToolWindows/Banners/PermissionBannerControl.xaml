<UserControl x:Class="VsAgentic.VSExtension.ToolWindows.Banners.PermissionBannerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VsAgentic.VSExtension;component/ToolWindows/SharedStyles.xaml"/>
                <ResourceDictionary Source="/VsAgentic.VSExtension;component/ToolWindows/Banners/BannerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- One half of the session split button. No border of its own: the
                 split's outer border draws it. The hover fill is rounded only on
                 the outer side, chosen by Tag="Left" or Tag="Right". -->
            <Style x:Key="SplitHalfButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                <Setter Property="Padding" Value="14,5,14,5"/>
                <Setter Property="Cursor" Value="Hand"/>
                <!-- The popup hands focus back to the chevron when it closes,
                     which drew WPF's dotted keyboard-focus rectangle after a
                     mouse click. -->
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Tag" Value="Left">
                                    <Setter TargetName="bd" Property="CornerRadius" Value="3,0,0,3"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="Right">
                                    <Setter TargetName="bd" Property="CornerRadius" Value="0,3,3,0"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="Single">
                                    <Setter TargetName="bd" Property="CornerRadius" Value="3"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseOverBackgroundGradientKey}}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseDownBackgroundGradientKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A choice in the "more ways to allow" menu: full width, left
                 aligned, no border, highlighted on hover like a menu item. -->
            <Style x:Key="MenuChoiceButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="10,6,10,6"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseOverBackgroundGradientKey}}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background"
                                            Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseDownBackgroundGradientKey}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource BannerCardBorderStyle}">
        <StackPanel>
            <TextBlock Text="{Binding Header}"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                       Margin="12,10,12,4"
                       TextWrapping="Wrap"/>

            <!-- The tooltip is here as well as on the warnings: a command with
                 no warning is the case where "can still be risky" matters. -->
            <TextBlock Text="{Binding BodyText}"
                       Visibility="{Binding HasBodyText, Converter={StaticResource BoolToVis}}"
                       ToolTip="{Binding RiskNotesTooltip}"
                       FontFamily="Consolas, Cascadia Mono, Menlo"
                       FontSize="12"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                       Opacity="0.7"
                       Margin="12,0,12,8"
                       MaxHeight="160"
                       TextWrapping="Wrap"/>

            <!-- What is unusual about the call, one line per pattern that
                 matched. Right under the command, above the buttons, so it is
                 read before a click. The text keeps the theme colour, so a
                 custom theme cannot make it unreadable; only the icon is
                 yellow. -->
            <ItemsControl ItemsSource="{Binding RiskNotes}"
                          Visibility="{Binding HasRiskNotes, Converter={StaticResource BoolToVis}}"
                          ToolTip="{Binding RiskNotesTooltip}"
                          Focusable="False"
                          Margin="12,0,12,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,1,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- A yellow warning triangle in the Windows
                                 warning colour. Not KnownMonikers.StatusWarning:
                                 VS darkens that one to ochre on a light
                                 background. The fixed yellow with a dark mark
                                 and a thin dark edge reads on light and dark
                                 themes alike. -->
                            <Viewbox Width="14" Height="14"
                                     Margin="0,2,6,0"
                                     VerticalAlignment="Top">
                                <Canvas Width="16" Height="16">
                                    <Path Data="M8,1.2 L15.2,14.6 L0.8,14.6 Z"
                                          Fill="#FFC83D"
                                          Stroke="#7A5800"
                                          StrokeThickness="0.8"
                                          StrokeLineJoin="Round"/>
                                    <Rectangle Canvas.Left="7.2" Canvas.Top="5.4"
                                               Width="1.6" Height="5"
                                               RadiusX="0.6" RadiusY="0.6"
                                               Fill="#1F1F1F"/>
                                    <Ellipse Canvas.Left="7.1" Canvas.Top="11.3"
                                             Width="1.8" Height="1.8"
                                             Fill="#1F1F1F"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Initial state: the rules the session button would add, then
                 Allow / Allow for this session / Deny / Other... / View diff in a single
                 row. The session button and the line above it are hidden
                 together when the request gives nothing stable to build a rule
                 from. Clicking Allow or Deny dispatches immediately; Other...
                 swaps the block out for the alternative-input row below. -->
            <StackPanel Visibility="{Binding IsInitialMode, Converter={StaticResource BoolToVis}}">

                <!-- On the banner, not only in the tooltip: a compound command
                     grants a rule per segment, and what the click covers has to
                     be readable next to the command it came from. -->
                <TextBlock Margin="12,0,12,8"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                           Opacity="0.75"
                           Visibility="{Binding CanAllowForSession, Converter={StaticResource BoolToVis}}">
                    <Run Text="{Binding RulesLineLead, Mode=OneWay}"/><Run Text="{Binding SessionRulesText, Mode=OneWay}"
                                                                   FontFamily="Consolas, Cascadia Mono, Menlo"/>
                </TextBlock>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            Margin="6,2,12,10">
                    <Button Content="Allow"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AllowCommand}"/>
                    <!-- Split button. The main half keeps the session allow a single
                         click; the chevron opens the longer-lived and broader
                         choices, which are rarer and more consequential. One outer
                         border and a divider make the two halves read as one
                         control, drawn like SecondaryButtonStyle. -->
                    <Border x:Name="SessionSplit"
                            Margin="6,0,0,0"
                            BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                            BorderThickness="1"
                            CornerRadius="4"
                            SnapsToDevicePixels="True"
                            Visibility="{Binding CanAllowForSession, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <!-- Without a menu (a rule that may hold a credential,
                                 so no Always) the session half is the whole
                                 button and rounds all four corners. -->
                            <Button Content="Allow for this session"
                                    Command="{Binding AllowForSessionCommand}"
                                    ToolTip="{Binding AllowForSessionTooltip}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SplitHalfButtonStyle}">
                                        <Setter Property="Tag" Value="Left"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMoreAllowChoices}" Value="False">
                                                <Setter Property="Tag" Value="Single"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Width="1"
                                    Background="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                                    Visibility="{Binding HasMoreAllowChoices, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource SplitHalfButtonStyle}"
                                    Tag="Right"
                                    Padding="8,5,8,5"
                                    ToolTip="More ways to allow"
                                    Visibility="{Binding HasMoreAllowChoices, Converter={StaticResource BoolToVis}}"
                                    Click="MoreAllowButton_Click">
                                <TextBlock Text="&#xE70D;"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10"
                                           VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Border>
                    <Button Content="Deny"
                            Style="{StaticResource DangerButtonStyle}"
                            Command="{Binding DenyCommand}"/>
                    <Button Content="Other..."
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding OtherCommand}"/>
                    <!-- A file edit: compare the file with the edit applied
                         before deciding. The banner stays open. -->
                    <Button Content="View diff"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ViewDiffCommand}"
                            ToolTip="Compare the file as it is now with the file after this change"
                            Visibility="{Binding CanViewDiff, Converter={StaticResource BoolToVis}}"/>

                    <Popup x:Name="MoreAllowPopup"
                           PlacementTarget="{Binding ElementName=SessionSplit}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBackgroundKey}}"
                                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="4"
                                Margin="0,4,0,0">
                            <!-- Each label names both axes, which commands and for how
                                 long. The tooltip spells out the rules granted. -->
                            <StackPanel MinWidth="220">
                                <Button Content="Always allow"
                                        Style="{StaticResource MenuChoiceButtonStyle}"
                                        ToolTip="{Binding AllowAlwaysTooltip}"
                                        Visibility="{Binding CanAllowAlways, Converter={StaticResource BoolToVis}}"
                                        Click="MoreAllowChoice_Click"
                                        Command="{Binding AllowAlwaysCommand}"/>
                                <Button Content="Allow similar for this session"
                                        Style="{StaticResource MenuChoiceButtonStyle}"
                                        ToolTip="{Binding AllowSimilarForSessionTooltip}"
                                        Visibility="{Binding CanAllowSimilar, Converter={StaticResource BoolToVis}}"
                                        Click="MoreAllowChoice_Click"
                                        Command="{Binding AllowSimilarForSessionCommand}"/>
                                <Button Content="Always allow similar"
                                        Style="{StaticResource MenuChoiceButtonStyle}"
                                        ToolTip="{Binding AllowSimilarAlwaysTooltip}"
                                        Visibility="{Binding CanAllowSimilarAlways, Converter={StaticResource BoolToVis}}"
                                        Click="MoreAllowChoice_Click"
                                        Command="{Binding AllowSimilarAlwaysCommand}"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </StackPanel>

            <!-- Why View diff opened nothing: the edit no longer matches the
                 file, or the file is too large. -->
            <TextBlock Text="{Binding DiffNotice}"
                       Visibility="{Binding HasDiffNotice, Converter={StaticResource BoolToVis}}"
                       FontSize="12"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"
                       Opacity="0.8"
                       Margin="12,0,12,10"
                       TextWrapping="Wrap"/>

            <!-- Other... state: textbox for alternative instructions, Submit
                 sends them as a wrapped deny, the small icon button to the
                 right of Submit returns to the initial state. -->
            <StackPanel Margin="12,2,12,10"
                        Visibility="{Binding IsOtherMode, Converter={StaticResource BoolToVis}}">
                <TextBox Style="{StaticResource BannerInputTextBoxStyle}"
                         Text="{Binding AlternativeText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Tell Claude what to do instead"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0">
                    <Button Content="Submit"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SubmitCommand}"/>
                    <Button Style="{StaticResource ChevronButtonStyle}"
                            Command="{Binding BackCommand}"
                            ToolTip="Back to Allow / Deny"
                            Margin="6,0,0,0">
                        <TextBlock Text="&#xE112;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
