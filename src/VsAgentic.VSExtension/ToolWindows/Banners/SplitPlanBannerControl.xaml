<UserControl x:Class="VsAgentic.VSExtension.ToolWindows.Banners.SplitPlanBannerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VsAgentic.VSExtension;component/ToolWindows/Banners/BannerStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- The plan for splitting a task across agents: Claude makes it in a copy
         of the session, the user can change the model of each part, then runs
         it or drops it. -->
    <Border Style="{StaticResource BannerCardBorderStyle}">
        <StackPanel>
            <DockPanel Margin="12,10,12,2">
                <TextBlock DockPanel.Dock="Right"
                           Text="⚡ split across agents"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"/>
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
            </DockPanel>

            <TextBlock Text="{Binding TaskText}"
                       FontSize="11"
                       Margin="12,0,12,6"
                       MaxHeight="34"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"
                       ToolTip="{Binding TaskText}"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"/>

            <!-- While Claude plans. -->
            <TextBlock Text="Claude is planning on Sonnet. This takes a few seconds and adds nothing to the chat."
                       FontSize="12" FontStyle="Italic"
                       Margin="12,2,12,10"
                       TextWrapping="Wrap"
                       Visibility="{Binding IsPlanning, Converter={StaticResource BoolToVis}}"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"/>

            <TextBlock Text="{Binding ErrorText}"
                       FontSize="12"
                       Margin="12,2,12,10"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                       Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>

            <!-- The plan. -->
            <StackPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Reason}"
                           FontSize="12"
                           Margin="12,0,12,6"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>

                <Border Margin="12,0,12,4"
                        BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBorderKey}}">
                    <StackPanel>
                        <TextBlock Text="{Binding OrchestratorText}"
                                   FontSize="12"
                                   Margin="0,6,0,4"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"/>

                        <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Role}"
                                                           FontWeight="SemiBold" FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                <TextBlock Text="{Binding Details}"
                                                           FontSize="10" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"/>
                                                <TextBlock Text="{Binding EstimateText}"
                                                           FontSize="10" TextWrapping="Wrap"
                                                           Visibility="{Binding HasEstimate, Converter={StaticResource BoolToVis}}"
                                                           ToolTip="Estimate for this part on the model chosen here"
                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"/>
                                            </StackPanel>
                                            <!-- The model of this part. Three buttons in one panel form one group. -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,0,10,0">
                                                <RadioButton Content="Haiku" IsChecked="{Binding IsHaiku}" Style="{StaticResource FluentRadioButtonStyle}" Margin="0,0,6,0"
                                                             ToolTip="Cheapest and fastest. Searching, reading, running tests."/>
                                                <RadioButton Content="Sonnet" IsChecked="{Binding IsSonnet}" Style="{StaticResource FluentRadioButtonStyle}" Margin="0,0,6,0"
                                                             ToolTip="Good value for writing code."/>
                                                <RadioButton Content="Opus" IsChecked="{Binding IsOpus}" Style="{StaticResource FluentRadioButtonStyle}"
                                                             ToolTip="Most capable and most expensive. Reviews and hard problems."/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Task}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           MaxHeight="50"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Task}"
                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                                <TextBlock Text="{Binding Warning, StringFormat='⚠ {0}'}"
                                                           FontSize="11"
                                                           FontStyle="Italic"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"
                                                           Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Alone against agents: cost and time, the bars to scale by
                     cost. Estimated again when a model changes. -->
                <Grid Margin="12,4,12,2"
                      Visibility="{Binding HasEstimate, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="168"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Alone" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                    <Border Grid.Row="0" Grid.Column="1" Height="8" HorizontalAlignment="Left" Width="{Binding AloneBar}" CornerRadius="2"
                            Background="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AloneText}" FontSize="12" Margin="4,1,0,1"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Agents" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                    <Border Grid.Row="1" Grid.Column="1" Height="8" HorizontalAlignment="Left" Width="{Binding AgentsBar}" CornerRadius="2"
                            Background="{DynamicResource {x:Static vs:VsBrushes.HighlightKey}}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AgentsText}" FontSize="12" Margin="4,1,0,1"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding EstimateNote}" FontSize="11" Margin="0,4,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"/>
                </Grid>

                <!-- Made from the task alone, because the chat is long. The
                     button plans again in a copy of the chat. -->
                <DockPanel Margin="12,2,12,4"
                           Visibility="{Binding HasHistoryNote, Converter={StaticResource BoolToVis}}">
                    <Button DockPanel.Dock="Right"
                            Content="Plan with chat history"
                            Style="{StaticResource SecondaryButtonStyle}"
                            VerticalAlignment="Top"
                            Command="{Binding PlanWithHistoryCommand}"
                            ToolTip="Plan again in a copy of this chat, so the plan knows what the chat has read. The chat itself gets nothing added."/>
                    <TextBlock Text="{Binding HistoryNote}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}"/>
                </DockPanel>

                <TextBlock Text="{Binding Footnote}"
                           FontSize="11"
                           Margin="12,2,12,6"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.CommandBarTextInactiveKey}}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="8,0,12,10">
                <!-- The button Claude recommends is the primary one: Run with
                     agents for a split that pays off, Continue alone otherwise.
                     Both stay available. Cancel puts the task back in the box. -->
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelCommand}"
                        ToolTip="Close the plan and put the task back in the message box"/>
                <Button Content="Continue alone"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding AloneCommand}"
                        Visibility="{Binding PreferAgents, Converter={StaticResource BoolToVis}}"
                        ToolTip="Send the task as an ordinary message, without subagents"/>
                <Button Content="Run with agents"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RunCommand}"
                        Visibility="{Binding PreferAlone, Converter={StaticResource BoolToVis}}"/>
                <Button Content="Continue alone"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AloneCommand}"
                        Visibility="{Binding PreferAlone, Converter={StaticResource BoolToVis}}"
                        ToolTip="Send the task as an ordinary message, without subagents"/>
                <Button Content="Run with agents"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding RunCommand}"
                        Visibility="{Binding PreferAgents, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
