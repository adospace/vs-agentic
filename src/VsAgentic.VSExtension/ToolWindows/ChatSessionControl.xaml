<UserControl x:Class="VsAgentic.VSExtension.ToolWindows.ChatSessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:controls="clr-namespace:VsAgentic.UI.Controls;assembly=VsAgentic.UI"
             xmlns:svc="clr-namespace:VsAgentic.Services.Abstractions;assembly=VsAgentic.Services"
             xmlns:bvm="clr-namespace:VsAgentic.UI.ViewModels.Banners;assembly=VsAgentic.UI"
             xmlns:bv="clr-namespace:VsAgentic.VSExtension.ToolWindows.Banners"
             xmlns:local="clr-namespace:VsAgentic.VSExtension.ToolWindows"
             PreviewMouseWheel="OnPreviewMouseWheel"
             PreviewKeyDown="OnPreviewKeyDown"
             PreviewMouseDown="OnPreviewMouseDown" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VsAgentic.VSExtension;component/ToolWindows/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <controls:AttachmentPreviewConverter x:Key="AttachmentPreviewConverter"/>
        <controls:MinWidthVisibilityConverter x:Key="MinWidth"/>

        <!-- Flashes the status bar background while waiting for input. To-only
             animation with AutoReverse, so the themed base colour never has to
             be restated here: it animates from whatever the brush currently is
             and back. Keyframes can't carry a DynamicResource anyway (a
             Storyboard is a Freezable), and VsBrushes keys resolve to a Brush,
             not the Color a colour keyframe needs. -->
        <Storyboard x:Key="FlashStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <ColorAnimation Storyboard.TargetProperty="Background.Color"
                            To="#66808080" Duration="0:0:0.75"/>
        </Storyboard>

        <!-- Status bar pickers. Fully retemplated rather than merely unbordered:
             the stock ComboBox chrome draws its own border, background and
             focus ring, none of which BorderThickness="0" removes. What is left
             is the label plus a chevron, with a hover fill borrowed from the
             command bar so it still reads as clickable. -->
        <Style x:Key="StatusComboStyle" TargetType="ComboBox">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!-- Foreground is forwarded explicitly. ToggleButton's
                                 own default style sets it to the system control
                                 text colour, and a style setter beats an
                                 inherited value, so without this local value the
                                 label renders near-black on a dark theme no
                                 matter what the ComboBox says. -->
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome"
                                                Background="Transparent"
                                                CornerRadius="3"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="6,0,2,0"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <Path Grid.Column="1"
                                                      Margin="0,1,6,0"
                                                      VerticalAlignment="Center"
                                                      Data="M 0 0 L 3.5 3.5 L 7 0 Z"
                                                      Fill="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseOverBackgroundGradientKey}}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chrome" Property="Background"
                                                        Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseDownBackgroundGradientKey}}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Opens upwards: the status bar sits at the bottom
                                 of the window, like the @-mention popup. -->
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Top"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBackgroundKey}}"
                                        BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        SnapsToDevicePixels="True">
                                    <ItemsPresenter/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Both pickers stay enabled while a turn is running. The
                     change goes to the running CLI and applies from its next
                     request, so it no longer kills the reply in flight. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The Fast switch: the same flat chrome as the pickers. Checked keeps
             the pressed fill, so "on" reads at a glance without a colour of
             its own. -->
        <Style x:Key="StatusToggleStyle" TargetType="ToggleButton">
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                CornerRadius="3"
                                Padding="6,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseOverBackgroundGradientKey}}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseDownBackgroundGradientKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StatusComboItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background"
                                        Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseOverBackgroundGradientKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Zoom for everything that is not the WebView. One instance, shared
             by LayoutTransform on each docked child, so the code-behind moves
             the whole chrome by setting a single pair of numbers. LayoutTransform
             rather than RenderTransform: the scaled chrome has to claim its new
             size from the DockPanel, otherwise it grows over the chat instead
             of pushing it. The chat itself is scaled through the browser's own
             zoom, which stays crisp where a bitmap scale would not. -->
        <ScaleTransform x:Key="ChromeZoom" ScaleX="1" ScaleY="1"/>

        <!-- Attachment chips above the input box. An image shows a thumbnail; a
             file has nothing worth previewing, so it shows its name instead.
             The tooltip is the path both came from, and stays away on a
             screenshot, which came from no file. -->
        <DataTemplate DataType="{x:Type svc:ChatImageAttachment}">
            <Border Margin="0,0,6,6"
                    BorderThickness="1"
                    CornerRadius="3"
                    BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                    ToolTip="{Binding SourcePath}">
                <Grid>
                    <Image Source="{Binding Converter={StaticResource AttachmentPreviewConverter}}"
                           Height="56"
                           Stretch="Uniform"
                           Margin="2"/>
                    <Button Content="&#xE10A;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="9"
                            Width="16" Height="16"
                            Padding="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            ToolTip="Remove image"
                            Click="RemoveAttachment_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type svc:ChatFileAttachment}">
            <Border Margin="0,0,6,6"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="6,3"
                    VerticalAlignment="Top"
                    BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                    ToolTip="{Binding SourcePath}">
                <StackPanel Orientation="Horizontal">
                    <imaging:CrispImage Width="14" Height="14"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Moniker="{x:Static catalog:KnownMonikers.Document}"/>
                    <TextBlock Text="{Binding DisplayName}"
                               VerticalAlignment="Center"
                               MaxWidth="220"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
                    <Button Content="&#xE10A;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="9"
                            Width="16" Height="16"
                            Padding="0"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Remove file"
                            Click="RemoveAttachment_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The file open in the editor, or the lines selected in it, once the
             user has attached it: a chip like a pasted file. The tooltip is the
             path with the lines, which is what the message names. -->
        <DataTemplate DataType="{x:Type svc:EditorContext}">
            <Border Margin="0,0,6,6"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="6,3"
                    VerticalAlignment="Top"
                    BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                    ToolTip="{Binding Reference}">
                <StackPanel Orientation="Horizontal">
                    <imaging:CrispImage Width="14" Height="14"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"
                                        Moniker="{x:Static catalog:KnownMonikers.TextFile}"/>
                    <TextBlock Text="{Binding DisplayName}"
                               VerticalAlignment="Center"
                               MaxWidth="260"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
                    <Button Content="&#xE10A;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="9"
                            Width="16" Height="16"
                            Padding="0"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="Remove"
                            Click="RemoveAttachment_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- The same, only offered, as a button beside @ and the paperclip:
             grey text in the status bar, so it reads as an action like theirs.
             Nothing goes out until the user clicks it. -->
        <DataTemplate x:Key="EditorContextSuggestionTemplate" DataType="{x:Type svc:EditorContext}">
            <!-- Dynamic: the style is defined further down the resources. -->
            <Button Style="{DynamicResource IconButtonStyle}"
                    Click="AcceptEditorContext_Click">
                <Button.ToolTip>
                    <TextBlock>
                        <Run Text="Attach to the next message:"/>
                        <LineBreak/>
                        <Run Text="{Binding Reference, Mode=OneWay}"/>
                    </TextBlock>
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="9"
                               VerticalAlignment="Center"
                               Margin="0,0,4,0"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"/>
                    <!-- Only the name is shortened: the lines are what tells
                         one suggestion from the next. -->
                    <TextBlock Text="{Binding FileName}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               MaxWidth="180"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"/>
                    <TextBlock Text="{Binding LineRange}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Banner DataTemplates: ContentControl below picks the right view by VM type. -->
        <DataTemplate DataType="{x:Type bvm:PermissionBannerViewModel}">
            <bv:PermissionBannerControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type bvm:LoginBannerViewModel}">
            <bv:LoginBannerControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type bvm:QuestionCardViewModel}">
            <bv:QuestionCardControl/>
        </DataTemplate>

        <!-- Borderless icon button used inside the input status bar -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseOverBackgroundGradientKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseDownBackgroundGradientKey}}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SendButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ListBoxItem template used in the @-mention popup -->
        <Style x:Key="MentionItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border"
                                CornerRadius="3"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarMouseOverBackgroundGradientKey}}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="{DynamicResource {x:Static vs:VsBrushes.CommandBarSelectedKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel x:Name="RootPanel"
               Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}">

        <!-- Input Area -->
        <Border DockPanel.Dock="Bottom"
                LayoutTransform="{StaticResource ChromeZoom}"
                Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
                Padding="6,2,6,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Resize grip: thin transparent strip the user can drag up/down -->
                <Border x:Name="ResizeGrip"
                        Grid.Row="0"
                        Height="6"
                        Background="Transparent"
                        Cursor="SizeNS"
                        MouseLeftButtonDown="ResizeGrip_MouseLeftButtonDown"
                        MouseMove="ResizeGrip_MouseMove"
                        MouseLeftButtonUp="ResizeGrip_MouseLeftButtonUp"
                        ToolTip="Drag to resize input"/>

                <!-- Rounded input container holding the textbox + status bar.

                     The whole box takes a drop, not just the textbox: the strip
                     of attachments and the status bar are part of what the user
                     aims at, and a file dropped on either belongs to the same
                     message. Only a file drop is taken here; text dragged out of
                     an editor falls through to the textbox, which inserts it. -->
                <Border x:Name="PromptBox"
                        Grid.Row="1"
                        CornerRadius="4"
                        Background="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBackgroundKey}}"
                        BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True"
                        AllowDrop="True"
                        PreviewDragOver="PromptBox_PreviewDragOver"
                        PreviewDragLeave="PromptBox_PreviewDragLeave"
                        PreviewDrop="PromptBox_PreviewDrop"
                        MouseEnter="PromptBox_MouseEnter">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Pasted images and files waiting to go out with the next
                             message. The template per attachment kind is picked up
                             from the resources by DataType. -->
                        <ItemsControl Grid.Row="0"
                                      ItemsSource="{Binding PendingAttachments}"
                                      Margin="8,6,8,0">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PendingAttachments.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Text input + placeholder overlay -->
                        <Grid Grid.Row="1">
                            <TextBox x:Name="InputTextBox"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                                     CaretBrush="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                                     BorderThickness="0"
                                     Padding="8,6"
                                     FontSize="13"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="36"
                                     MaxHeight="120"
                                     VerticalScrollBarVisibility="Auto"
                                     KeyDown="InputTextBox_KeyDown"
                                     PreviewKeyDown="InputTextBox_PreviewKeyDown"
                                     TextChanged="InputTextBox_TextChanged"
                                     SelectionChanged="InputTextBox_SelectionChanged"
                                     GotKeyboardFocus="InputTextBox_GotKeyboardFocus"
                                     LostKeyboardFocus="InputTextBox_LostKeyboardFocus"/>

                            <!-- @-mention popup: anchored above the input box, holds a filtered file/folder list -->
                            <Popup x:Name="MentionPopup"
                                   PlacementTarget="{Binding ElementName=InputTextBox}"
                                   Placement="Top"
                                   StaysOpen="True"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border Background="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBackgroundKey}}"
                                        BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        MinWidth="260"
                                        MaxWidth="520"
                                        SnapsToDevicePixels="True">
                                    <ListBox x:Name="MentionList"
                                             MaxHeight="220"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Focusable="False"
                                             ItemContainerStyle="{StaticResource MentionItemStyle}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             PreviewMouseLeftButtonDown="MentionList_PreviewMouseLeftButtonDown">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <imaging:CrispImage Grid.Column="0"
                                                                        Width="14" Height="14"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,6,0"
                                                                        Moniker="{Binding Moniker}"/>
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding RelativePath}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            <TextBlock Text="Type your message, CTRL+Enter to send, @ to insert"
                                       Margin="11,6,0,0"
                                       VerticalAlignment="Top"
                                       IsHitTestVisible="False"
                                       FontSize="13"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=InputTextBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Status bar (separated from textbox by a top line) -->
                        <Border Grid.Row="2"
                                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                                BorderThickness="0,1,0,0">
                            <!-- A local brush, not the shared VsBrushes one: the themed
                                 brushes are frozen and can't be animated. -->
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource {x:Static vs:VsColors.ComboBoxBackgroundKey}}"/>
                            </Border.Background>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <!-- IsFlashing, not Activity: the view model already
                                             folds the state and the user's Appearance switch
                                             into one answer, so the switch logic stays in
                                             one place as more states are added. -->
                                        <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="FlashBegin" Storyboard="{StaticResource FlashStoryboard}"/>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="FlashBegin"/>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left of the status readings: the two ways of
                                     putting a file into the next message. They are
                                     not the same thing. @ writes a reference into
                                     the text and only reaches the workspace; the
                                     paperclip attaches a file from anywhere, and an
                                     image attached this way travels inline. -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <!-- @-mention attach button: opens the file/folder picker popup -->
                                    <Button x:Name="AtMentionButton"
                                            Style="{StaticResource IconButtonStyle}"
                                            Click="AtMentionButton_Click"
                                            ToolTip="Insert file or folder reference (@)">
                                        <TextBlock Text="@"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
                                    </Button>

                                    <Button x:Name="AttachFileButton"
                                            Style="{StaticResource IconButtonStyle}"
                                            Click="AttachFileButton_Click"
                                            ToolTip="Attach files to the next message.&#x0a;Images go inline; anything else is sent as a path.">
                                        <imaging:CrispImage Width="16" Height="16"
                                                            Moniker="{x:Static catalog:KnownMonikers.AddAttachment}"/>
                                    </Button>

                                    <!-- The third way: the file open in the editor,
                                         or its selection, one click away. An action
                                         next to the other two, not a chip above the
                                         input, so it does not read as attached. -->
                                    <ItemsControl ItemsSource="{Binding EditorContextSuggestions}"
                                                  ItemTemplate="{StaticResource EditorContextSuggestionTemplate}"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"/>
                                </StackPanel>

                                <!-- Status info: usage readings and the model /
                                     effort pickers, right-aligned towards Send.

                                     Each item names the cell width it needs and
                                     drops out below it. Context is the last to go:
                                     it is ambient, and hidden it cannot warn that a
                                     compaction is near. The pickers go first: they
                                     are occasional actions, reachable again by
                                     widening the pane or through Tools → Options.

                                     The thresholds are cumulative estimates of the
                                     items' widths, in unzoomed pixels. The cell is
                                     inside the zoomed chrome, so its ActualWidth
                                     shrinks with zoom and the same numbers hold.
                                     ClipToBounds keeps an overflow off the @ button. -->
                                <Grid Grid.Column="1"
                                      x:Name="StatusInfo"
                                      Margin="6,0"
                                      ClipToBounds="True">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">

                                        <!-- Plain text, not bars. Without a reading
                                             from the CLI the 5h and 7d budgets are
                                             estimates, and a bar would claim a
                                             precision they do not have. With one, the
                                             percentage is short and the colour warns;
                                             a bar would also cost width these cells
                                             do not have. -->
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding HasWindowMeters, Converter={StaticResource BoolToVis}}">
                                            <local:UsageMeter Caption="7d"
                                                              ValueText="{Binding LongWindowDisplay}"
                                                              Level="{Binding LongWindowLevel}"
                                                              ShowBar="False"
                                                              ToolTip="{Binding LongWindowTooltip}"
                                                              Visibility="{Binding ActualWidth, ElementName=StatusInfo,
                                                                           Converter={StaticResource MinWidth},
                                                                           ConverterParameter=255}"/>
                                            <local:UsageMeter Caption="5h"
                                                              ValueText="{Binding ShortWindowDisplay}"
                                                              Level="{Binding ShortWindowLevel}"
                                                              ShowBar="False"
                                                              ToolTip="{Binding ShortWindowTooltip}"
                                                              Visibility="{Binding ActualWidth, ElementName=StatusInfo,
                                                                           Converter={StaticResource MinWidth},
                                                                           ConverterParameter=170}"/>
                                        </StackPanel>

                                        <local:UsageMeter Caption="Session"
                                                          ValueText="{Binding SessionTokensDisplay}"
                                                          ShowBar="False"
                                                          ToolTip="{Binding SessionTokensTooltip}"
                                                          Visibility="{Binding ActualWidth, ElementName=StatusInfo,
                                                                       Converter={StaticResource MinWidth},
                                                                       ConverterParameter=325}"/>

                                        <!-- The one bar: the context ceiling is real,
                                             derived from the model id. -->
                                        <local:UsageMeter ValueText="{Binding ContextDisplay}"
                                                          Fraction="{Binding ContextFraction}"
                                                          Level="{Binding ContextLevel}"
                                                          ToolTip="{Binding ContextTooltip}"/>

                                        <!-- Changing either picker goes to the running
                                             CLI process, which applies it from its next
                                             API request. An older CLI that cannot take
                                             it restarts before the next message; the
                                             conversation is resumed, not lost.

                                             An ItemTemplate, not DisplayMemberPath:
                                             the Default row renames itself once the
                                             model is known, and StatusComboStyle only
                                             forwards SelectionBoxItemTemplate. With
                                             DisplayMemberPath that is null, so the
                                             closed box would draw ToString() once and
                                             keep showing "Default". -->
                                        <ComboBox Style="{StaticResource StatusComboStyle}"
                                                  ItemsSource="{Binding ModelOptions}"
                                                  SelectedItem="{Binding SelectedModel}"
                                                  Visibility="{Binding ActualWidth, ElementName=StatusInfo,
                                                               Converter={StaticResource MinWidth},
                                                               ConverterParameter=405}">
                                            <!-- A TextBlock, not ToolTip="{Binding ...
                                                 StringFormat=...}": the ToolTip property
                                                 is typed object, so the binding has no
                                                 target type to format to and the tooltip
                                                 reads as the bare model name. -->
                                            <ComboBox.ToolTip>
                                                <TextBlock Text="{Binding ModelDisplay,
                                                           StringFormat='Model: {0}&#x0a;Takes effect on the next request, also during a reply.'}"/>
                                            </ComboBox.ToolTip>
                                            <!-- The CLI's description of each model, on the
                                                 row in the open list. Not on the template:
                                                 that also draws the closed box and would
                                                 cover the tooltip above. -->
                                            <ComboBox.ItemContainerStyle>
                                                <Style TargetType="ComboBoxItem"
                                                       BasedOn="{StaticResource StatusComboItemStyle}">
                                                    <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                </Style>
                                            </ComboBox.ItemContainerStyle>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- The levels come from the selected model; a
                                             model without effort disables the box. -->
                                        <ComboBox Style="{StaticResource StatusComboStyle}"
                                                  ItemContainerStyle="{StaticResource StatusComboItemStyle}"
                                                  ItemsSource="{Binding EffortOptions}"
                                                  SelectedItem="{Binding SelectedEffortOption}"
                                                  IsEnabled="{Binding HasEffort}"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  Visibility="{Binding ActualWidth, ElementName=StatusInfo,
                                                               Converter={StaticResource MinWidth},
                                                               ConverterParameter=480}">
                                            <ComboBox.ToolTip>
                                                <TextBlock Text="{Binding EffortTooltip}"/>
                                            </ComboBox.ToolTip>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <!-- Only for a model the CLI offers fast mode for.
                                             Two conditions, so two elements: the width
                                             rule on the wrapper, the model rule on the
                                             switch. -->
                                        <Border Visibility="{Binding ActualWidth, ElementName=StatusInfo,
                                                             Converter={StaticResource MinWidth},
                                                             ConverterParameter=525}">
                                            <ToggleButton Style="{StaticResource StatusToggleStyle}"
                                                          Content="Fast"
                                                          IsChecked="{Binding IsFastModeOn}"
                                                          IsEnabled="{Binding CanToggleFastMode}"
                                                          ToolTipService.ShowOnDisabled="True"
                                                          Visibility="{Binding ShowFastMode, Converter={StaticResource BoolToVis}}">
                                                <ToggleButton.ToolTip>
                                                    <TextBlock Text="{Binding FastModeTooltip}"/>
                                                </ToggleButton.ToolTip>
                                            </ToggleButton>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <!-- Send / Stop buttons -->
                                <Grid Grid.Column="2" Margin="2">
                                    <Button Style="{StaticResource SendButtonStyle}"
                                            Command="{Binding SendCommand}"
                                            ToolTip="Send (Ctrl+Enter)">
                                        <imaging:CrispImage Width="16" Height="16"
                                                            Moniker="{x:Static catalog:KnownMonikers.Send}"/>
                                    </Button>
                                    <Button Style="{StaticResource StopButtonStyle}"
                                            Command="{Binding StopCommand}"
                                            ToolTip="Stop processing">
                                        <imaging:CrispImage Width="16" Height="16"
                                                            Moniker="{x:Static catalog:KnownMonikers.Stop}"/>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Shown while a file is dragged over the box. An overlay
                             rather than a colour on the container itself: setting
                             BorderBrush from code would replace the themed brush
                             with a local value and keep it after the drop. -->
                        <Border x:Name="DropHighlight"
                                Grid.Row="0" Grid.RowSpan="3"
                                CornerRadius="4"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.HighlightKey}}"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Status indicator. The wording per state and the empty-means-hidden
             rule both live on the view model's StatusText, so a new state does
             not add a trigger here. -->
        <Border DockPanel.Dock="Bottom"
                LayoutTransform="{StaticResource ChromeZoom}"
                Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
                Padding="16,4">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <!-- Three dots on a ring that turns in 3D while Claude works.
                     Placed and sized from code on every frame, and only while
                     they show. -->
                <Canvas x:Name="WorkingDots"
                        DockPanel.Dock="Left"
                        Width="16" Height="16"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"
                        Visibility="Collapsed">
                    <Canvas.Resources>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"/>
                        </Style>
                    </Canvas.Resources>
                    <Ellipse/>
                    <Ellipse/>
                    <Ellipse/>
                </Canvas>
                <TextBlock Text="{Binding StatusText}"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource {x:Static vs:VsBrushes.GrayTextKey}}"
                           FontSize="12" FontStyle="Italic"/>
            </DockPanel>
        </Border>

        <!-- Background tasks: commands and subagents the CLI runs in the
             background. They outlive the turn, so this strip stays up between
             turns until the CLI reports them done. One row per task, each with
             its own Stop; a shell command's tooltip shows the end of its
             output. The pulse uses opacity only, so it needs no accent color
             from the theme. -->
        <Border DockPanel.Dock="Bottom"
                LayoutTransform="{StaticResource ChromeZoom}"
                Margin="6,4,6,0"
                Padding="8,2"
                CornerRadius="4"
                BorderThickness="1"
                BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBorderKey}}"
                Background="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}"
                Visibility="{Binding HasBackgroundTasks, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding BackgroundTaskItems}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource IconButtonStyle}"
                                    Padding="4,2"
                                    Command="{Binding StopCommand}"
                                    ToolTip="Stop this task"
                                    AutomationProperties.Name="Stop background task">
                                <imaging:CrispImage Width="14" Height="14"
                                                    Moniker="{x:Static catalog:KnownMonikers.Stop}"/>
                            </Button>
                            <Ellipse DockPanel.Dock="Left"
                                     Width="8" Height="8"
                                     Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}">
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 From="1" To="0.2" Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock Text="{Binding Description, StringFormat='Running in background: {0}'}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12"
                                       Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"
                                       ToolTipOpening="BackgroundTask_ToolTipOpening">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <TextBlock Text="{Binding ToolTipText}"
                                                   FontFamily="Consolas"
                                                   TextWrapping="NoWrap"/>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Banner host: permission / question / login banner. The DataTemplates
             above pick the matching UserControl by VM type. The host collapses
             when ActiveBanner is null so it consumes no space when idle. -->
        <ContentControl DockPanel.Dock="Bottom"
                        x:Name="BannerHost"
                        LayoutTransform="{StaticResource ChromeZoom}"
                        Content="{Binding ActiveBanner}"
                        Focusable="False">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

        <!-- Chat Messages Area - single WebView -->
        <Grid>
            <controls:ChatWebView x:Name="ChatWebView" />

            <!-- Zoom reading, shown in the corner of the chat for a moment
                 after each step and then faded out, the way a browser does it.

                 A Popup rather than a plain Border in this Grid, because the
                 WebView2 control is an HwndHost: WPF cannot draw over a child
                 HWND, so a Border laid on top would simply not appear where it
                 overlapped the chat. A Popup gets its own top-level window and
                 sits above it.

                 Deliberately outside the scaled chrome and at a fixed size — it
                 reports the zoom, so it must not be subject to it. -->
            <Popup x:Name="ZoomToast"
                   PlacementTarget="{Binding ElementName=ChatWebView}"
                   Placement="Custom"
                   StaysOpen="True"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Focusable="False"
                   IsHitTestVisible="False">
                <Border Padding="10,4"
                        CornerRadius="3"
                        IsHitTestVisible="False"
                        Background="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBackgroundKey}}"
                        BorderBrush="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}"
                        BorderThickness="1"
                        SnapsToDevicePixels="True">
                    <TextBlock x:Name="ZoomToastText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}"/>
                </Border>
            </Popup>
        </Grid>
    </DockPanel>
</UserControl>
